<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>disaster_brain</name>
  <version>0.1.0</version>
  <description>Disaster Rover brain: sensor-only perception, hazard prediction, utility behaviour selection, safety reflexes, risk-weighted A*, plus a local Gemma 4 mission agent with a rule-set guardrail.</description>
  <maintainer email="kaya.claridge@gmail.com">kayaclaridge-sys</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
